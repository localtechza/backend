# LocalTech backend environment variables.
#
# LOCAL RUNS:  copy this file to `.env` (never commit `.env`).
# RENDER:      Dashboard → your service → Environment → add them there.

# ── Order storage, customer login and the invoice counter ─────────────────
# MongoDB Atlas free cluster (Database → Connect → Drivers → copy the URI).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=localtech

# ── The hidden #/admin order desk ──────────────────────────────────────────
# Any digits/letters you like — it is compared against this value, never
# stored. Required before the admin page will open.
ADMIN_PIN=123456

# ── Recommended ────────────────────────────────────────────────────────────
# Random string that signs admin sessions. Without it, the admin page asks
# for the PIN again after each redeploy (customer logins live in MongoDB and
# always survive).
SESSION_SECRET=put-a-long-random-string-here

# Where Paystack sends customers back after paying.
SITE_URL=https://localtechza.github.io

# Invoice floor: numbers start here (and never go below it). Set this to the
# next number you need if you already issued some, e.g. 204.
INVOICE_START=200

# ── Already configured on Render (do not paste real keys here) ─────────────
# RESEND_API_KEY=
# PAYSTACK_SECRET_KEY=
# ADMIN_EMAIL=
# FROM_EMAIL=
# PORT=10000
